T11:21:00-04:00"}, {"@id": "https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.59b1e4c9738ef385916508073fdb5b6ce0c4bdaa.001.1", "identifier": "urn:oid:2.49.0.1.840.0.59b1e4c9738ef385916508073fdb5b6ce0c4bdaa.001.1", "sender": "w-nws.webmaster@noaa.gov", "sent": "2026-08-30T16:00:00-04:00"}], "sent": "2026-08-30T19:41:00-04:00", "effective": "2026-08-30T19:41:00-04:00", "onset": "2026-08-30T19:41:00-04:00", "expires": "2026-08-31T05:30:00-04:00", "ends": "2026-08-31T18:00:00-04:00", "status": "Actual", "messageType": "Update", "category": "Met", "severity": "Moderate", "certainty": "Likely", "urgency": "Expected", "event": "Rip Current Statement", "sender": "w-nws.webmaster@noaa.gov", "senderName": "NWS San Juan PR", "headline": "Rip Current Statement issued August 30 at 7:41PM AST until August 31 at 6:00PM AST by NWS San Juan PR", "description": "* WHAT..Life-threatening rip currents.\n\n* WHERE...Beaches of northern, eastern and southeastern Puerto\nRico, Vieques, Culebra, and the U.S. Virgin Islands.\n\n* WHEN...Through Monday afternoon.\n\n* IMPACTS...Rip currents can sweep even the best swimmers away\nfrom shore into deeper water, where it becomes difficult to\nreturn to safety.", "instruction": "There is a high risk of rip currents.\n\nRip currents are powerful channels of water flowing quickly away\nfrom shore, which occur most often at low spots or breaks in the\nsandbar and in the vicinity of structures such as groins, jetties\nand piers. Heed the advice of lifeguards, beach patrol flags and\nsigns.\n\nIf you become caught in a rip current, yell for help. Remain\ncalm, do not exhaust yourself and stay afloat while waiting for\nhelp. If you have to swim out of a rip current, swim parallel to\nshore and back toward the beach when possible. Do not attempt to\nswim directly against a rip current as you will tire quickly.", "response": "Avoid", "note": null, "parameters": {"AWIPSidentifier": ["CFWSJU"], "WMOidentifier": ["WHCA42 TJSJ 302341"], "NWSheadline": ["HIGH RIP CURRENT RISK REMAINS IN EFFECT THROUGH MONDAY AFTERNOON"], "BLOCKCHANNEL": ["EAS", "NWEM", "CMAS"], "VTEC": ["/O.CON.TJSJ.RP.S.0020.000000T0000Z-260831T2200Z/"], "eventEndingTime": ["2026-08-31T18:00:00-04:00"], "expiredReferences": ["w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.90ce1a2c76392d5dfcdc4b8549f72ae9567cf21f.001.1,2026-08-30T03:48:00-04:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.3f2ed5a95aa1e341a622d7fb453005bc2d9ccc6a.001.1,2026-08-29T10:00:00-04:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.18dbe873d1f274089a1665db199b19e3556e39ad.001.1,2026-08-29T21:59:00-04:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.ef96f25d18892d9d14ce84c66a84d9aec2e6ff12.001.1,2026-08-29T16:13:00-04:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.184761b840f71543c1f3f6dc114a2a95cd224659.001.1,2026-08-29T06:30:00-04:00"]}, "scope": "Public", "code": "IPAWSv1.0", "language": "en-US", "web": "http://www.weather.gov", "eventCode": {"SAME": ["NWS"], "NationalWeatherService": ["RPS"]}}}], "title": "Current watches, warnings, and advisories for Puerto Rico", "updated": "2026-08-31T02:48:39+00:00"}